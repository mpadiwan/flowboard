# FlowBoard environment template. Copy to .env before `docker compose up`:
#   cp .env.example .env
# Values here are local-development placeholders only. Never commit a real .env.
# Full reference: docs/arch-docs/flowboard/ARCH-flowboard.md §11.3
# Each group notes the milestone that first reads it; variables for later milestones
# are listed now so this file stays the single complete list.

# ── Runtime (day-01) ─────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── PostgreSQL (day-01 container; used by the api from day-03) ──
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowboard
DATABASE_URL=postgresql://flowboard:change-me@db:5432/flowboard

# ── Seed (day-03) ────────────────────────────────────────────────
# Password for dev@flowboard.test, created by `npx prisma db seed`. At least 8 characters.
SEED_USER_PASSWORD=change-me-dev-password

# ── Redis (day-01 container; used by the api from day-06) ───────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth (week-01 complete / day-07) ─────────────────────────────
# At least 32 characters each, and the two must differ (ADR-004).
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
# Used for both the refresh JWT expiry and its Redis key TTL (7 days).
JWT_REFRESH_TTL_SECONDS=604800
# Minimum 12.
BCRYPT_COST=12

# ── HTTP security (day-11) ───────────────────────────────────────
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# ── Rate limiting and lockout (day-06 / day-12) ──────────────────
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX=100
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# ── Worker (day-08) ──────────────────────────────────────────────
WORKER_CONSUMER_NAME=worker-1
WORKER_MAX_DELIVERIES=3
# Minimum idle time (ms) before XAUTOCLAIM reclaims a pending message.
WORKER_CLAIM_IDLE_MS=30000
