meta {
  name: Validation error
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: inherit
}

body:json {
  {
    "title": "   ",
    "priority": "URGENT",
    "boardId": "not-a-uuid"
  }
}

tests {
  test("422 VALIDATION_ERROR", function() {
    expect(res.status).to.equal(422);
    expect(res.body.success).to.equal(false);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
  });

  test("details name every bad field", function() {
    const paths = res.body.details.map((detail) => detail.path);
    expect(paths).to.include.members(["title", "priority", "boardId"]);
  });
}

docs {
  ADR-007. Every invalid field is reported in `details: [{ path, message }]`.
  A title of only spaces is empty after trimming.
}
