meta {
  name: Login - wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{demoEmail}}",
    "password": "not-the-password"
  }
}

tests {
  test("401 INVALID_CREDENTIALS", function() {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal("INVALID_CREDENTIALS");
  });
}

docs {
  A wrong password and an unknown email get the same 401 and take the same bcrypt time, so
  login can't be used to find out which emails are registered (ARCH §8).

  Each failure counts towards the per-email lockout; the successful login that follows resets it.
}
