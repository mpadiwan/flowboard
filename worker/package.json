{
  "name": "flowboard-worker",
  "version": "0.1.0",
  "private": true,
  "description": "FlowBoard background worker: consumes tasks:events and writes AuditLog rows.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "jest",
    "prisma:generate": "mkdir -p prisma && cp ../api/prisma/schema.prisma prisma/schema.prisma && prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "ioredis": "5.11.1",
    "pino": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "jest": "29.7.0",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
