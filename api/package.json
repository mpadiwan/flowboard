{
  "name": "flowboard-api",
  "version": "0.1.0",
  "private": true,
  "description": "FlowBoard REST API (Express 4 + TypeScript).",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.22.3",
    "pino": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "pino-pretty": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
